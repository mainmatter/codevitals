# Loads the dev shell (the Rust of rust-toolchain.toml, duckdb, cv-grafana) on
# entering the directory, so every shell, editor and agent builds with the same
# toolchain and environment and cargo never rebuilds for a mismatch. Needs direnv;
# nix-direnv caches the shell and keeps the toolchain from Nix's garbage collector.
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
watch_file rust-toolchain.toml
# cv-grafana serves a copy of these taken when the shell is built: rebuild it when they change.
watch_file grafana/dashboards/*.json grafana/provisioning/*/*.yaml
use flake
